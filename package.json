{
  "name": "runningup",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "RunningUp — 3D real-run linked idle action RPG. Tooling, content pipeline and domain engine.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "doctor": "bash tools/bootstrap/doctor.sh",
    "content:build": "node tools/content-factory/build.mjs",
    "content:seed": "node tools/content-factory/emit-seed.mjs",
    "validate:content": "node tools/content-validator/validate.mjs",
    "validate:direction-lock": "node tools/direction-lock/scan.mjs",
    "simulate:passport": "node tools/runner-passport-simulator/simulate.mjs",
    "simulate:apex": "node tools/monthly-apex-simulator/simulate.mjs",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:db": "bash scripts/db.sh",
    "test:fast": "npm run validate:direction-lock && npm run validate:content && npm run test:unit",
    "test:all": "bash scripts/all.sh",
    "fixtures:build": "node tools/run-fixture-generator/generate.mjs",
    "simulate:anticheat": "node tools/anti-cheat-simulator/simulate.mjs",
    "conformance:export": "node tools/conformance/export-fixtures.mjs && node tools/conformance/emit-sql-conformance.mjs",
    "test:client": "dotnet test client/dotnet/RunningUp.Domain.Tests/RunningUp.Domain.Tests.csproj --nologo",
    "play": "node client/cli/play.mjs",
    "play:auto": "node client/cli/play.mjs --auto",
    "play:smoke": "node client/cli/smoke-play.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
